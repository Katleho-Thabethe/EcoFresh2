<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="30dp"
            android:text="@string/product_details_title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Barcode Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/barcode_label"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Scanned Barcode -->
        <TextView
            android:id="@+id/barcodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:padding="12dp"
            android:text="@string/barcode_placeholder"
            android:textSize="18sp" />

        <!-- Product Name -->
        <EditText
            android:id="@+id/productName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:autofillHints="name"
            android:hint="@string/product_name_hint"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:padding="12dp"
            android:singleLine="true" />

        <!-- Category -->
        <EditText
            android:id="@+id/category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:autofillHints="none"
            android:hint="@string/category_hint"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:padding="12dp"
            android:singleLine="true" />

        <!-- Expiry Date Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Expiry Date"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Expiry Date -->
        <EditText
            android:id="@+id/expiryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:autofillHints="none"
            android:hint="DD/MM/YYYY"
            android:inputType="text"
            android:minHeight="48dp"
            android:padding="12dp"
            android:singleLine="true" />

        <!-- Date Format Information -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:text="Enter the expiry date in DD/MM/YYYY format."
            android:textSize="14sp" />

        <!-- Save Product Button -->
        <Button
            android:id="@+id/saveProductButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/save_product"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>